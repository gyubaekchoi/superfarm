local shim = require("./_shim")
local H = require("./_harness")
local Format = shim.require("src/shared/Util/Format")
local Economy = shim.require("src/shared/Config/Economy")

print("Format")
H.test("short", function()
	H.eq(Format.short(0), "0")
	H.eq(Format.short(999), "999")
	H.eq(Format.short(1000), "1K")
	H.eq(Format.short(1250), "1.25K")
	H.eq(Format.short(12500), "12.5K")
	H.eq(Format.short(125000), "125K")
	H.eq(Format.short(1250000), "1.25M")
	H.eq(Format.short(3400000), "3.4M")
end)

print("Economy")
H.test("levelForXP", function()
	H.eq(Economy.levelForXP(0), 1)
	H.eq(Economy.levelForXP(149), 1)
	H.eq(Economy.levelForXP(150), 2)
	H.eq(Economy.levelForXP(1000), 3)
	H.eq(Economy.levelForXP(99999), 9)
	H.eq(Economy.levelForXP(100000), 10)
	H.eq(Economy.levelForXP(1e9), 10)
end)
