local shim = require("./_shim")
local H = require("./_harness")
local Enhance = shim.require("src/shared/Config/Enhance")

print("Enhance")
H.test("비용: 0→1 은 2, 9→10 은 11", function()
	H.eq(Enhance.cost(0), 2)
	H.eq(Enhance.cost(9), 11)
end)

H.test("💎 8 → 2단계(비활성), 9 → 3단계(활성)", function()
	local n8 = Enhance.previewLevels(8, 0)
	local n9, spent9 = Enhance.previewLevels(9, 0)
	H.eq(n8, 2, "8")
	H.eq(n9, 3, "9")
	H.eq(spent9, 9, "spent")
	H.eq(Enhance.isActive(8, 0), false)
	H.eq(Enhance.isActive(9, 0), true)
end)

H.test("💎 20 → +5 (2+3+4+5+6)", function()
	local n, spent = Enhance.previewLevels(20, 0)
	H.eq(n, 5)
	H.eq(spent, 20)
end)

H.test("💎 65 → +10", function()
	H.eq((Enhance.previewLevels(65, 0)), 10)
end)

H.test("💎 495 → +30 (상한), 초과분은 남는다", function()
	local n, spent = Enhance.previewLevels(10000, 0)
	H.eq(n, 30)
	H.eq(spent, 495)
end)

H.test("이미 +28 이면 최대 2단계 → 비활성", function()
	H.eq((Enhance.previewLevels(1000, 28)), 2)
	H.eq(Enhance.isActive(1000, 28), false)
end)
